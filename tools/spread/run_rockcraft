#!/bin/bash

# run_rockcraft: helper to run rockcraft with possible debug handling and
# os-specific checks.

if os.query is-fedora; then
    # rockcraft commands might fail the first time due to https://bugs.launchpad.net/snapd/+bug/2002835
    echo "Fedora detected; trying every rockcraft command twice"
    retry -n 2 rockcraft "$@"
else
    for attempt in 1 2 3; do
        if rockcraft "$@"; then
            exit 0
        fi
        rc=$?
        log_file=$(find /root/.local/state/rockcraft/log/ -name 'rockcraft*.log' 2>/dev/null | sort -n | tail -n1)
        if [[ "$attempt" -lt 3 ]] && [[ -f "$log_file" ]] && grep -qE 'Service Unavailable|CONNECT tunnel failed|connection reset by peer|Failed to fetch|Temporary failure in name resolution|TLS handshake timeout|context deadline exceeded' "$log_file"; then
            echo "Transient network error detected in $log_file; retrying rockcraft (attempt $((attempt + 1))/3)..." >&2
            sleep 10
        else
            exit "$rc"
        fi
    done
fi
